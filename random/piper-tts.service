[Unit]
Description=Piper TTS HTTP Server
Documentation=https://github.com/rhasspy/piper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dietpi
Group=dietpi
WorkingDirectory=/hexapod/libs/voices

# Environment variables
Environment="PATH=/hexapod/libs/pip/tts/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/hexapod/libs/pip/tts"
Environment="TTS_VOICE_MODEL=en_US-amy-medium.onnx"

# Direct execution using the virtual environment's python
ExecStart=/hexapod/libs/pip/tts/bin/python3 -m piper.http_server -m en_US-amy-medium.onnx

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=piper-tts

# Restart policy
Restart=always
RestartSec=10s

# Security settings (optional but recommended)
NoNewPrivileges=true
PrivateTmp=true

# Resource limits (adjust as needed for RPi4)
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
